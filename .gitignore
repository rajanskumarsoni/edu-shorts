.env
.env.*
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/

# Node / Remotion
node_modules/
.remotion/

# Media build artifacts & renders
media/
out/
public/*
!public/.gitkeep
!public/sfx/
!public/music/
!public/models/
audio/*
!audio/.gitkeep
episodes/*/final*.mp4

# Installer archives & local toolchains
.tools/

# Scratch / one-off test files
out.mp3
test.py
images/

# Pipeline-generated text artifacts (re-run --export-text / --align to regenerate)
audio/*/*.txt
!audio/*/timings.txt

# Episode-specific generated artifacts; keep briefs, scripts, storyboards, and provenance tracked.
episodes/*/audio/
episodes/*/media/
!episodes/templates/media/
!episodes/templates/media/**
episodes/*/final*.mp4
episodes/*/final_audio_qa.json
episodes/*/final_contact_sheet.*
episodes/*/*-thumbnail.*
episodes/*/thumbnail.*
episodes/.uploaded_manifest.json

# Transient renders, QA frames, and experiments are not source assets.
scratch/

